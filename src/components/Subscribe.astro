<form
  action="https://buttondown.com/api/emails/embed-subscribe/schustersoftware"
  method="post"
  class="embeddable-buttondown-form flex flex-col items-center gap-2 my-12"
>
  <label for="bd-email">follow along - get the next post by email</label>
  <div class="flex gap-2">
    <input
      type="email"
      name="email"
      id="bd-email"
      required
      class="border border-black bg-white px-3 py-1 w-56"
    />
    <input
      type="submit"
      value="Subscribe"
      class="border border-black px-4 py-1 cursor-pointer hover:bg-black hover:text-white"
    />
  </div>
</form>
